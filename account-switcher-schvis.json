{
  "id": "account-switcher-schvis",
  "name": "Account Switcher",
  "version": "1.0.11",
  "manifestURI": "https://raw.githubusercontent.com/Schvis/seanime-extension/refs/heads/main/account-switcher-schvis.json",
  "language": "javascript",
  "type": "plugin",
  "description": "Save and switch between multiple AniList accounts from the profile menu.",
  "author": "Schvis",
  "payloadURI": "https://raw.githubusercontent.com/Schvis/seanime-extension/refs/heads/main/account-switcher.js",
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": [
        "auth",
        "storage"
      ],
      "allow": {
        "unsafeFlags": [
          {
            "flag": "dom-script-manipulation"
          }
        ]
      }
    }
  }
}
